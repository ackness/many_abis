{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ackness/many_abis/registry/schemas/deployments.schema.json",
  "title": "many-abis explicit protocol deployments",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "deployments"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "deployments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain",
          "deployment",
          "protocol",
          "protocol_version",
          "deployment_version",
          "role",
          "name",
          "address",
          "abi",
          "source_url",
          "source_reviewed_at"
        ],
        "properties": {
          "chain": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "deployment": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "protocol": {
            "type": "string",
            "minLength": 1
          },
          "protocol_version": {
            "type": "string",
            "minLength": 1
          },
          "deployment_version": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "pool_manager",
              "state_view",
              "quoter",
              "position_manager",
              "router",
              "permit2",
              "vault"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "abi": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "source_reviewed_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
