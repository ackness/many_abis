{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ackness/many_abis/registry/schemas/contract-index.schema.json",
  "title": "many-abis generated contract index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contracts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "abi",
          "address",
          "chain",
          "chain_id",
          "contract_id",
          "name",
          "protocol",
          "protocol_version",
          "provenance_status",
          "role",
          "source_url",
          "verification_id",
          "source_reviewed_at"
        ],
        "properties": {
          "abi": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "chain": {
            "type": "string"
          },
          "chain_id": {
            "type": "integer",
            "minimum": 1
          },
          "contract_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "protocol": {
            "type": [
              "string",
              "null"
            ]
          },
          "protocol_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance_status": {
            "enum": [
              "legacy_unverified",
              "verified"
            ]
          },
          "role": {
            "enum": [
              "factory",
              "permit2",
              "pool_manager",
              "position_manager",
              "quoter",
              "router",
              "stablecoin",
              "state_view",
              "test_token",
              "vault",
              "wrapped_native"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "verification_id": {
            "type": "string",
            "minLength": 1
          },
          "source_reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "deployment_version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
